# Here I keep all the backend secrets. Copy this file to .env and fill in the values.
PORT=5000
MONGO_URI=mongodb://localhost:27031,localhost:27032,localhost:27033/tripmate?replicaSet=rs0
JWT_SECRET=put-a-long-random-string-here
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Here I make the two keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:you@example.com
